{
  "name": "openclaw-plugin-company-os",
  "version": "0.6.0",
  "description": "Hierarchical company governance for OpenClaw: meetings, tasks, notices, and organization.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "preview:fixture": "node scripts/preview-fixture.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "plugin:build": "npm run build",
    "plugin:validate": "npm run build && node scripts/validate-plugin.mjs"
  },
  "files": [
    "dist",
    "web/dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "dependencies": {
    "nodemailer": "^9.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openclaw": "latest",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
