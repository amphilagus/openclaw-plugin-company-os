{
  gateway: {
    controlUi: {
      // Required so the same-origin Company OS iframe can reuse Gateway login.
      embedSandbox: "trusted",
    },
  },
  plugins: {
    entries: {
      "company-os": {
        enabled: true,
        // Enables the trusted agent_end fast path. The tool path also waits for
        // OpenClaw's active-run registry to report this main session as idle.
        hooks: {
          allowConversationAccess: true,
        },
        config: {
          participantTurnTimeoutSeconds: 600,
          hostIdleTimeoutSeconds: 1800,
          meetingAutoEndDelaySeconds: 60,
          taskStaleAfterHours: 72,
          taskHourlyCheckins: {
            enabled: true,
            startHour: 8,
            endHour: 17,
          },
          // Defaults to the OpenClaw Agent marked default: true.
          // organizationAdminAgentId: "jia-goushi",
          // Boss is a human member, so this avatar does not come from agents.list.
          bossAvatarPath: "~/.openclaw/workspace-boss/avatar.png",
          bossEmailNotifications: {
            enabled: true,
            // Defaults to ~/.config/mail-skills/.env and sends to USERNAME.
            // account: "work",
            // recipient: "boss@qq.com",
            // configPath: "~/.config/mail-skills/.env",
          },
          // Optional. Default: ~/.openclaw/plugins/company-os/company-os.sqlite
          // databasePath: "/absolute/path/company-os.sqlite",
        },
      },
    },
  },
}
